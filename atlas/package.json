{
  "name": "batch-signal-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "atlas": "tsx scripts/build-atlas.ts",
    "dev": "npm run atlas && concurrently -k -n api,web \"tsx watch server/main.ts\" \"vite\"",
    "build": "npm run atlas && tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "test": "npm run atlas && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "classify": "tsx scripts/classify.ts",
    "artifact": "npm run atlas && tsx scripts/pack-artifact.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
